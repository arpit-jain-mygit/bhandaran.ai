# Copy to .env (git-ignored) and adjust.

# local = PostgreSQL on this machine, dsql = Aurora DSQL in AWS
DB_MODE=local

# Used when DB_MODE=local
LOCAL_DATABASE_URL=postgresql+psycopg://localhost:5432/bhandaran

# Used when DB_MODE=dsql  (terraform -chdir=infra/envs/dev output dsql_endpoint)
DSQL_ENDPOINT=<cluster-id>.dsql.ap-south-1.on.aws
DSQL_USER=admin
AWS_REGION=ap-south-1

# JSON list of browser origins allowed to call the API
CORS_ORIGINS=["http://localhost:4200"]

# Login (M3). Secret for signing login tokens and hashing OTP codes:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-to-a-long-random-string
# Local only: show the OTP code on the login page instead of sending SMS.
OTP_DELIVERY=response
# Plain http://localhost: allow the session cookie without HTTPS.
COOKIE_SECURE=false
